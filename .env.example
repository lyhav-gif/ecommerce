# ==========================================
# APP CONFIGURATION
# ==========================================
APP_NAME=MEAW
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=2592000


# ==========================================
# MONGODB DATABASE (NOSQL)
# ==========================================
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=api


# ==========================================
# BAKONG KHQR CONFIGURATION
# ==========================================
BAKONG_ENV=sandbox

# Bakong API Base URL
BAKONG_API_URL=https://api-bakong.nbc.gov.kh

# Bakong API Token
BAKONG_TOKEN=your_bakong_jwt_token_here

# Bakong Account Information
BAKONG_ACCOUNT_ID=your_account@bkrt
BAKONG_MERCHANT_NAME=YOUR_MERCHANT_NAME
BAKONG_PHONE_NUMBER=012345678


# ==========================================
# KHQR CONFIGURATION
# ==========================================
KHQR_CURRENCY=KHR
KHQR_COUNTRY=KH
KHQR_CITY=Phnom Penh

