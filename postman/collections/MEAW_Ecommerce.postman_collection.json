        {
          "name": "2. List All Products (Auto-saves product_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length > 0) {",
                  "    const aura = json.data.find(p => p.name.includes('Aura Cream')) || json.data[0];",
                  "    pm.collectionVariables.set('product_id', aura.id || aura.name);",
                  "    if (aura.md5) pm.collectionVariables.set('product_md5', aura.md5);",
                  "    if (aura.khqr) pm.collectionVariables.set('product_khqr', aura.khqr);",
                  "    console.log('Saved product_id:', aura.id || aura.name, 'md5:', aura.md5);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products"]
            }
          }
        },
        {
          "name": "3. Filter Products by Category (Beauty)",
          "request": {
            "method": "GET",
            "header": [],
